<mxGeometry x="1040" y="360" width="360" height="60" as="geometry"/>
</mxCell>
<mxCell id="note-relations" value="&lt;b&gt;Relationships (Crow's Foot notation)&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;One to Many:&lt;/b&gt; Users (1) to Bookings (N). One user can make many bookings.&lt;br&gt;2. &lt;b&gt;Many to One:&lt;/b&gt; Bookings (N) to Matches (1). Many bookings can belong to one match.&lt;br&gt;3. &lt;b&gt;One to One (logical):&lt;/b&gt; every booking row connects exactly one user with exactly one match for one reserved seat.&lt;br&gt;The side with two bars means exactly one. The side with a circle and a crow's foot means zero or many." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=12;" vertex="1" parent="1">
<mxGeometry x="40" y="450" width="1360" height="100" as="geometry"/>
</mxCell>
